# Application
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
# Display environment. Never set LIVE unless you intend real-money paths.
ATCC_DISPLAY_MODE=demo
# LIVE execution is blocked unless this is explicitly true AND the user enables it in-app.
ATCC_LIVE_ENABLED=false
# Autonomous live trading is blocked unless this is explicitly true AND the user enables it in-app.
ATCC_AUTONOMOUS_ENABLED=false

# Session cookie signing. Generate a long random string for any shared deploy.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# SQLite is the default local/dev/test store. PostgreSQL is used when DATABASE_URL is set.
DATABASE_PATH=./data/atcc.sqlite
# DATABASE_URL=postgres://atcc:atcc@localhost:5432/atcc

# Redis is optional. Without it, jobs run from the durable SQLite/Postgres job table.
# REDIS_URL=redis://127.0.0.1:6379

# Paid services stay OFF unless configured. Do not put live broker secrets here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Alpaca PAPER keys only. Live Alpaca trading is refused unless ATCC_LIVE_ENABLED=true.
# ALPACA_PAPER_KEY=
# ALPACA_PAPER_SECRET=
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Optional market-data keys. Demo/fixture data is used when none are set.
# MARKETDATA_PROVIDER=demo

# AI cost ceilings (USD). Zero means the provider is not called.
AI_DAILY_LIMIT_USD=0
AI_MONTHLY_LIMIT_USD=0
