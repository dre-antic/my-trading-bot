# Optional. Public candle data does not need keys.
# Live orders stay disabled unless ENABLE_LIVE_TRADING=true.
BINANCE_API_KEY=
BINANCE_SECRET=
ENABLE_LIVE_TRADING=false

# Where strategies, paper trades, and the local database are stored.
TRADINGBOT_DATA_DIR=./data

# Host/port for the local desk.
TRADINGBOT_HOST=127.0.0.1
TRADINGBOT_PORT=8765
