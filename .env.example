# Application
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
# Display environment. Never set LIVE unless you intend real-money paths.
ATCC_DISPLAY_MODE=demo
# LIVE execution is blocked unless this is explicitly true AND the user enables it in-app.
ATCC_LIVE_ENABLED=false
# Autonomous live trading is blocked unless this is explicitly true AND the user enables it in-app.
ATCC_AUTONOMOUS_ENABLED=false

# Session cookie signing. Generate a long random string for any shared deploy.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# SQLite is the default local/dev/test store. PostgreSQL schema+migrate is available when DATABASE_URL is set.
# The app query path remains SQLite-first. Do not claim a dual-runtime production rewrite.
DATABASE_PATH=./data/atcc.sqlite
# DATABASE_URL=postgres://atcc:atcc@localhost:5432/atcc

# Redis is optional wake-up. Without it, jobs run from the durable SQL job table.
# REDIS_URL=redis://127.0.0.1:6379

# Trading engine. native is the default. lean probes the CLI and refuses invented LEAN results.
# ATCC_ENGINE=native

# Paid services stay OFF unless configured. Do not put live broker secrets here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Alpaca PAPER keys only unless you also complete every live gate in LIVE_TRADING.md.
# ALPACA_PAPER_KEY=
# ALPACA_PAPER_SECRET=
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Alpaca LIVE keys must be DISTINCT from paper keys. Host is pinned to api.alpaca.markets.
# Never point ALPACA_LIVE_BASE_URL at paper-api.alpaca.markets.
# ALPACA_LIVE_KEY=
# ALPACA_LIVE_SECRET=
# ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# OANDA. Practice is not real money. Live host is api-fxtrade.oanda.com only.
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice

# Market data. demo = labeled synthetic. stooq = free historical CSV (default when unset). alpaca = keys required.
# MARKETDATA_PROVIDER=stooq

# Optional alert transports. Unconfigured channels return sent=false and are recorded. Nothing is faked.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# EMAIL_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# VAPID_PUBLIC_KEY=

# AI cost ceilings (USD). Zero means the provider is not called even if a key is present.
AI_DAILY_LIMIT_USD=0
AI_MONTHLY_LIMIT_USD=0
