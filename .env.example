# Aether Studio — copy to .env and fill in only the keys you have.
# NEVER commit real secrets. The Settings UI writes to data/secrets.json, not this file.

# --- Core ---
DEMO_MODE=true
OFFLINE_MODE=false
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
DATA_DIR=./data
PROJECTS_DIR=./projects

# Hardware-aware defaults for older machines (2013 Mac / 8GB RAM)
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
FFMPEG_PRESET=veryfast
MAX_CONCURRENT_JOBS=1

# --- Budget (never charge without approval) ---
ALLOW_PAID_PROVIDERS=false
MAX_DAILY_SPEND=0
MAX_MONTHLY_SPEND=0
REQUIRE_APPROVAL_ABOVE_COST=0
JOB_BUDGET_USD=0

# --- Approval ---
# full_automatic | approve_before_render | approve_final | approve_expensive
APPROVAL_MODE=approve_final
QC_SCORE_THRESHOLD=85
QC_MAX_RETRIES=2

# --- LLM (free-first; leave blank if unused) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Search (Wikipedia/Wikimedia need no key) ---
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Stock media ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- TTS / STT ---
# Local espeak-ng is the default. Kokoro/Piper/cloud are optional.
KOKORO_ENABLED=false
PIPER_BIN=
OPENAI_TTS_MODEL=tts-1
ELEVENLABS_API_KEY=
GROQ_WHISPER=true

# --- Optional remote render / storage ---
RENDER_PROVIDER=ffmpeg
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Local encryption for saved settings (auto-generated if empty)
AETHER_MASTER_KEY=
