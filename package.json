{
  "name": "ai-trading-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "AI Trading Command Center — research, risk, paper execution, and human-approved trading desk",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:worker": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "start:worker": "tsx src/worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:pg": "tsx src/db/pg.ts",
    "db:seed": "tsx src/db/seed.ts",
    "verify:slice": "tsx scripts/verify-vertical-slice.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "decimal.js": "^10.5.0",
    "ioredis": "^5.6.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.9.1",
    "nanoid": "^5.1.5",
    "next": "^15.3.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.15.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3"
  }
}
